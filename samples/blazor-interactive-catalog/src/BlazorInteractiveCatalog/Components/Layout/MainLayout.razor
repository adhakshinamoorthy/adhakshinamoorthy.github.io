@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/">Blazor Catalog</a>
    <span>Interactive Server sample</span>
</header>

<main id="main-content">
    @Body
</main>

<div id="blazor-error-ui" role="alert">
    The application lost its connection. Reload the page to continue.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss connection message">×</button>
</div>
